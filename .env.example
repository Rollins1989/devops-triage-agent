# Optional. If set, all agents reason with real Claude (claude-sonnet-4-6)
# over real MCP tool calls instead of the offline deterministic playbook.
ANTHROPIC_API_KEY=

# If "true", the remediation agent actually executes restart/rollback/scale
# actions against the (simulated) infra instead of dry-running them.
# Equivalent to passing --confirm-actions on the CLI.
CONFIRM_ACTIONS=false
